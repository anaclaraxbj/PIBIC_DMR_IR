from pathlib import Path 
from collections import Counter

#Verifica se a pasta existe
DATA_DIR = Path(
    r"C:\Códigos\IC\PIBIC_DMR_IR\data\raw\DMR-IR")

print("Pasta encontrada:", DATA_DIR.exists())

# Lista todos os arquivos na pasta DMR-IR
files = [p for p in DATA_DIR.rglob("*") if p.is_file()]

print("Total de arquivos:", len(files))

extensions = Counter(p.suffix.lower() for p in files)


for ext, quantity in extensions.items():
    print(f"{ext or '[sem extensão]'}: {quantity}")

#Seleciona uma imagem aleatória e exibe suas informações

import random
from PIL import Image
import matplotlib.pyplot as plt

image_extensions = {".png", ".jpg", ".jpeg", ".bmp", ".tif", ".tiff"}

images = [
    p for p in files
    if p.suffix.lower() in image_extensions
]

print("Total de imagens:", len(images))

if images:
    image_path = random.choice(images)
    image = Image.open(image_path)

    print("Arquivo:", image_path)
    print("Tamanho:", image.size)
    print("Modo:", image.mode)

    plt.imshow(image)
    plt.axis("off")
    plt.show()
else:
    print("Nenhuma imagem com essas extensões foi encontrada.")

